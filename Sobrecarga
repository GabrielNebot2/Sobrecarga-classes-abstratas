#include <iostream>
#include <stdexcept>
#include <iomanip>

using namespace std;

class Conta {
private:
    int numero;
    string titular;
    double saldo;

public:
    Conta(int numero, string titular, double saldo) {
        this->numero = numero;
        this->titular = titular;
        this->saldo = saldo;
    }

    Conta& operator+=(double valor) {
        saldo += valor;
        return *this;
    }

    Conta& operator-(double valor) {
        if (saldo < valor) {
            throw runtime_error("Saldo insuficiente.");
        }

        saldo -= valor;
        return *this;
    }

    friend ostream& operator<<(ostream& out, const Conta& c) {
        out << fixed << setprecision(2);
        out << "Conta: " << c.numero << endl;
        out << "Titular: " << c.titular << endl;
        out << "Saldo: R$ " << c.saldo << endl;

        return out;
    }

    void transferir(Conta& destino, double valor) {
        if (saldo < valor) {
            throw runtime_error("Saldo insuficiente para transferencia.");
        }

        saldo -= valor;
        destino.saldo += valor;
    }
};

int main() {
    Conta conta1(101, "Gabriel", 1000.00);
    Conta conta2(202, "Maria", 500.00);

    try {
        conta1 += 500.00;

        conta1.transferir(conta2, 200.00);

        cout << conta1 << endl;
        cout << conta2 << endl;

    } catch (exception& e) {
        cout << "Erro: " << e.what() << endl;
    }

    return 0;
}
