#include <iostream>
#include <string>

using namespace std;

class Autenticacao {
public:
    virtual void coletarDados() = 0;
    virtual bool validarDados() = 0;

    void autenticar() {
        coletarDados();

        if (validarDados()) {
            cout << "Login realizado com sucesso!" << endl;
        } else {
            cout << "Falha na autenticacao!" << endl;
        }
    }
};

class LoginSenha : public Autenticacao {
private:
    string login;
    string senha;

public:
    void coletarDados() override {
        cout << "Login: ";
        cin >> login;

        cout << "Senha: ";
        cin >> senha;
    }

    bool validarDados() override {
        return login.length() > 4 && senha.length() > 8;
    }
};

class GoogleAuth : public Autenticacao {
private:
    string email;

public:
    void coletarDados() override {
        cout << "Email Google: ";
        cin >> email;
    }

    bool validarDados() override {
        return email.find("@gmail.com") != string::npos;
    }
};

class QRCodeAuth : public Autenticacao {
private:
    string codigo;

public:
    void coletarDados() override {
        cout << "Codigo QR: ";
        cin >> codigo;
    }

    bool validarDados() override {
        return codigo == "QR12345";
    }
};

int main() {
    int opcao;

    cout << "1 - Login e Senha" << endl;
    cout << "2 - Google Auth" << endl;
    cout << "3 - QR Code" << endl;
    cout << "Escolha: ";
    cin >> opcao;

    Autenticacao* auth;

    if (opcao == 1) {
        auth = new LoginSenha();
    } 
    else if (opcao == 2) {
        auth = new GoogleAuth();
    } 
    else if (opcao == 3) {
        auth = new QRCodeAuth();
    } 
    else {
        cout << "Opcao invalida!" << endl;
        return 0;
    }

    auth->autenticar();

    delete auth;

    return 0;
}
